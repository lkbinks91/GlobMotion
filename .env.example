# Copy to .env.local and fill in your own keys. Never commit .env.local.

# Required: AI recommendations, activities, deep dive, itinerary
ANTHROPIC_API_KEY=

# Google Maps 3D view (Maps JavaScript API + Geocoding API). Restrict by HTTP referrer in GCP.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Media gallery (optional)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Events aggregator (optional, each source is skipped if its key is missing)
TICKETMASTER_API_KEY=
EVENTBRITE_API_KEY=
SEATGEEK_CLIENT_ID=
SEATGEEK_CLIENT_SECRET=
# BANDSINTOWN_APP_ID=
# SONGKICK_API_KEY=

# Flight price comparison via RapidAPI (Sky Scrapper)
RAPIDAPI_KEY=
